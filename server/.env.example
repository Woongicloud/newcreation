PORT=3001

# 관리자 로그인 비밀번호 (서버에서만 확인한다. 클라이언트에는 넣지 않는다)
ADMIN_PASSWORD=your-secure-admin-password

# 토큰 서명 키 — 길고 무작위인 값 (예: openssl rand -hex 32)
# 없으면 서버가 뜰 때마다 임시 키를 만들어, 재시작 시 모두 다시 접속해야 한다.
TOKEN_SECRET=change-me-to-a-long-random-string

# Supabase (Settings → API). 둘 다 없으면 메모리 저장소로 뜬다 (로컬 확인용, 재시작 시 기록 소실)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_your-service-role-key

# 클라이언트 주소 (CORS 허용)
CLIENT_URL=http://localhost:5173
# 배포 시: CLIENT_URL=https://your-app.vercel.app
