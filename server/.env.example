PORT=3001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_your-service-role-key
ADMIN_PASSWORD=your-secure-admin-password
CLIENT_URL=http://localhost:5173
# 배포 시: CLIENT_URL=https://your-app.vercel.app

# v2 서버 (npm run dev:server:v2)
# 토큰 서명 키 — 길고 무작위인 값. 없으면 서버가 뜰 때마다 임시 키를 만들어, 재시작 시 모두 다시 로그인해야 한다.
TOKEN_SECRET=change-me-to-a-long-random-string
# v2 는 SUPABASE_* 가 없으면 메모리 저장소로 뜬다 (로컬 확인용)
